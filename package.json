{
  "name": "codex-quota-float-companion",
  "version": "0.1.14",
  "description": "Compact floating Codex quota companion",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "electron-builder --win",
    "test": "node --test test/*.test.js",
    "test:window": "node test/run-electron-layout.cjs",
    "test:alerts": "node test/run-electron-layout.cjs --alerts",
    "test:trends": "node test/run-electron-layout.cjs --trends",
    "test:notices": "node test/run-electron-layout.cjs --notices",
    "test:regressions": "node test/run-electron-layout.cjs --regressions"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "25.1.8"
  }
}
